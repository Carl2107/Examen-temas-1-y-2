{
	"name": "oro_df_fact_admisiones",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_admisiones_sql",
						"type": "DatasetReference"
					},
					"name": "admissions"
				},
				{
					"dataset": {
						"referenceName": "silver_diagnosis_sql",
						"type": "DatasetReference"
					},
					"name": "diagnoses"
				},
				{
					"dataset": {
						"referenceName": "oro_dim_paciente_sql",
						"type": "DatasetReference"
					},
					"name": "paciente"
				},
				{
					"dataset": {
						"referenceName": "oro_dim_departamentos_sql",
						"type": "DatasetReference"
					},
					"name": "departamento"
				},
				{
					"dataset": {
						"referenceName": "oro_dim_diagnostico_sql",
						"type": "DatasetReference"
					},
					"name": "diagnostico"
				},
				{
					"dataset": {
						"referenceName": "oro_dim_fecha_sql",
						"type": "DatasetReference"
					},
					"name": "fechaIngreso"
				},
				{
					"dataset": {
						"referenceName": "oro_dim_fecha_sql",
						"type": "DatasetReference"
					},
					"name": "fechaAlta"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "oro_fact_admisiones_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				},
				{
					"name": "joinDiagnostico"
				},
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "lookup2"
				},
				{
					"name": "lookup3"
				},
				{
					"name": "lookup4"
				},
				{
					"name": "lookup5"
				},
				{
					"name": "lookup6"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT * FROM silver.admissions',",
				"     format: 'query') ~> admissions",
				"source(output(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT * FROM silver.diagnoses',",
				"     format: 'query') ~> diagnoses",
				"source(output(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT paciente_key, patient_id_bk FROM gold.dim_paciente',",
				"     format: 'query') ~> paciente",
				"source(output(",
				"          departamento_key as integer,",
				"          nombre_departamento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT departamento_key, nombre_departamento FROM gold.dim_departamento',",
				"     format: 'query') ~> departamento",
				"source(output(",
				"          diagnostico_key as integer,",
				"          codigo_icd as string,",
				"          nivel_severidad as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT diagnostico_key, codigo_icd, nivel_severidad FROM gold.dim_diagnostico',",
				"     format: 'query') ~> diagnostico",
				"source(output(",
				"          fecha_key as integer,",
				"          fecha_completa as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT fecha_key, fecha_completa FROM gold.dim_fecha',",
				"     format: 'query') ~> fechaIngreso",
				"source(output(",
				"          fecha_key as integer,",
				"          fecha_completa as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT fecha_key, fecha_completa FROM gold.dim_fecha',",
				"     format: 'query') ~> fechaAlta",
				"diagnoses aggregate(groupBy(admission_id),",
				"     diagnosis_id_elegido = min(diagnosis_id)) ~> aggregate1",
				"aggregate1, diagnoses join(aggregate1@admission_id == diagnoses@admission_id",
				"     && diagnosis_id_elegido == diagnosis_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinDiagnostico",
				"admissions, joinDiagnostico join(admissions@admission_id == diagnoses@admission_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          admission_id = admissions@admission_id,",
				"          patient_id,",
				"          admission_date,",
				"          discharge_date,",
				"          department,",
				"          attending_doctor_id,",
				"          icd_code,",
				"          diagnosis_description,",
				"          severity",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, paciente lookup(patient_id == patient_id_bk,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup2",
				"lookup2, departamento lookup(trim(department) == nombre_departamento,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup3",
				"lookup3, diagnostico lookup(trim(icd_code) == codigo_icd",
				"     && iif(isNull(severity) || trim(severity) == '', 'Unknown', trim(severity)) == nivel_severidad,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup4",
				"lookup4, fechaIngreso lookup(admission_date == fecha_completa,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup5",
				"lookup5, fechaAlta lookup(discharge_date == fechaAlta@fecha_completa,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup6",
				"lookup6 derive(fecha_ingreso_key = fechaIngreso@fecha_key,",
				"          fecha_alta_key = fechaAlta@fecha_key,",
				"          dias_estancia = iif(isNull(discharge_date), toInteger(null()), toInteger((toLong(discharge_date) - toLong(admission_date)) / 86400000)),",
				"          diagnostico_key = iif(isNull(diagnostico_key), 1971, diagnostico_key)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admision_key as long,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          diagnostico_key as integer,",
				"          fecha_ingreso_key as integer,",
				"          fecha_alta_key as integer,",
				"          medico_id as integer,",
				"          dias_estancia as integer,",
				"          conteo_admisiones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id_bk = admission_id,",
				"          paciente_key,",
				"          departamento_key,",
				"          diagnostico_key,",
				"          fecha_ingreso_key,",
				"          fecha_alta_key,",
				"          medico_id = attending_doctor_id,",
				"          dias_estancia",
				"     )) ~> sink1"
			]
		}
	}
}