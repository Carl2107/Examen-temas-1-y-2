{
	"name": "oro_df_facturacion",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_admisiones_sql",
						"type": "DatasetReference"
					},
					"name": "admissions"
				},
				{
					"dataset": {
						"referenceName": "oro_dim_paciente_sql",
						"type": "DatasetReference"
					},
					"name": "paciente"
				},
				{
					"dataset": {
						"referenceName": "oro_dim_departamentos_sql",
						"type": "DatasetReference"
					},
					"name": "departamento"
				},
				{
					"dataset": {
						"referenceName": "oro_dim_servicio_cargo_sql",
						"type": "DatasetReference"
					},
					"name": "serviciocargo"
				},
				{
					"dataset": {
						"referenceName": "silver_facturacion_sql",
						"type": "DatasetReference"
					},
					"name": "facturacion"
				},
				{
					"dataset": {
						"referenceName": "oro_dim_fecha_sql",
						"type": "DatasetReference"
					},
					"name": "fecha"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "oro_fact_facturacion_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "lookup2"
				},
				{
					"name": "lookup3"
				},
				{
					"name": "lookup4"
				},
				{
					"name": "lookup5"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT * FROM silver.admissions',",
				"     format: 'query') ~> admissions",
				"source(output(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT paciente_key, patient_id_bk FROM gold.dim_paciente',",
				"     format: 'query') ~> paciente",
				"source(output(",
				"          departamento_key as integer,",
				"          nombre_departamento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT departamento_key, nombre_departamento FROM gold.dim_departamento',",
				"     format: 'query') ~> departamento",
				"source(output(",
				"          servicio_cargo_key as integer,",
				"          tipo_cargo as string,",
				"          estado_pago as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT servicio_cargo_key, tipo_cargo, estado_pago FROM gold.dim_servicio_cargo',",
				"     format: 'query') ~> serviciocargo",
				"source(output(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT * FROM silver.billing',",
				"     format: 'query') ~> facturacion",
				"source(output(",
				"          fecha_key as integer,",
				"          fecha_completa as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT fecha_key, fecha_completa FROM gold.dim_fecha',",
				"     format: 'query') ~> fecha",
				"facturacion, admissions join(facturacion@admission_id == admissions@admission_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          billing_id,",
				"          admission_id = facturacion@admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date,",
				"          patient_id,",
				"          department",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, paciente lookup(patient_id == patient_id_bk,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup2",
				"lookup2, departamento lookup(trim(department) == nombre_departamento,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup3",
				"lookup3, serviciocargo lookup(trim(charge_type) == tipo_cargo",
				"     && trim(payment_status) == estado_pago,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup4",
				"lookup4, fecha lookup(payment_date == fecha_completa,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup5",
				"lookup5 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          facturacion_key as long,",
				"          billing_id_bk as integer,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          servicio_cargo_key as integer,",
				"          fecha_pago_key as integer,",
				"          monto_facturado as decimal(12,2),",
				"          conteo_transacciones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id_bk = billing_id,",
				"          admission_id_bk = admission_id,",
				"          paciente_key,",
				"          departamento_key,",
				"          servicio_cargo_key,",
				"          fecha_pago_key = fecha_key,",
				"          monto_facturado = amount",
				"     )) ~> sink1"
			]
		}
	}
}