							"type": "NonQuery",
							"text": "SET XACT_ABORT ON;\n\nBEGIN TRY\n    BEGIN TRANSACTION;\n\n    DELETE FROM gold.fact_facturacion;\n    DELETE FROM gold.fact_admisiones;\n\n    DELETE FROM gold.dim_servicio_cargo;\n    DELETE FROM gold.dim_diagnostico;\n    DELETE FROM gold.dim_departamento;\n    DELETE FROM gold.dim_paciente;\n    DELETE FROM gold.dim_fecha;\n\n    DBCC CHECKIDENT ('gold.fact_facturacion', RESEED, 0);\n    DBCC CHECKIDENT ('gold.fact_admisiones', RESEED, 0);\n    DBCC CHECKIDENT ('gold.dim_servicio_cargo', RESEED, 0);\n    DBCC CHECKIDENT ('gold.dim_diagnostico', RESEED, 0);\n    DBCC CHECKIDENT ('gold.dim_departamento', RESEED, 0);\n    DBCC CHECKIDENT ('gold.dim_paciente', RESEED, 0);\n\n    COMMIT TRANSACTION;\nEND TRY\nBEGIN CATCH\n    IF @@TRANCOUNT > 0\n        ROLLBACK TRANSACTION;\n    THROW;\nEND CATCH;"
